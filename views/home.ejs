<!DOCTYPE html>
<html lang="en">
  <head><%- include('./partials/head') %><title>BlogVerse — ideas worth sharing</title></head>
  <body class="d-flex flex-column min-vh-100">
    <%- include('./partials/nav') %>
    <main class="flex-fill">
      <section class="home-hero">
        <div class="eyebrow">A little space for big ideas</div>
        <h1>Stories make us<br /><span>see things differently.</span></h1>
        <p>Discover thoughtful writing from curious people. Find a fresh perspective, or share a story of your own.</p>
        <% if (locals.user) { %><a class="btn btn-primary mt-3" href="/blog/add-new">Write your first story <span aria-hidden="true">→</span></a><% } else { %><a class="btn btn-primary mt-3" href="/user/signup">Start writing <span aria-hidden="true">→</span></a><% } %>
      </section>
      <section class="post-grid">
        <div class="section-heading"><div><div class="eyebrow">From the community</div><h2>Latest stories</h2></div><span class="text-secondary"><%= totalBlogs %> stories</span></div>
        <form class="discover-filters" action="/" method="get">
          <label class="visually-hidden" for="story-search">Search stories</label>
          <input id="story-search" class="form-control" type="search" name="q" value="<%= search %>" placeholder="Search stories and ideas…" />
          <label class="visually-hidden" for="story-category">Filter by category</label>
          <select id="story-category" class="form-select" name="category">
            <option value="">All categories</option>
            <% categories.forEach(category => { %><option value="<%= category %>" <%= selectedCategory === category ? 'selected' : '' %>><%= category %></option><% }) %>
          </select>
          <button class="btn btn-primary" type="submit">Find stories</button>
          <% if (search || selectedCategory) { %><a class="btn btn-outline-light" href="/">Clear</a><% } %>
        </form>
        <% if (blogs.length) { %>
          <div class="row g-4">
            <% blogs.forEach(blog => { %>
              <div class="col-12 col-sm-6 col-lg-4 d-flex">
                <article class="card post-card w-100">
                  <img src="<%= blog.coverImageURL || '/images/default.jpg' %>" class="card-img-top" alt="Cover for <%= blog.title %>" loading="lazy" />
                  <div class="card-body d-flex flex-column"><span class="category-pill"><%= blog.category || 'Other' %></span><h3 class="card-title"><%= blog.title %></h3><a href="/blog/<%= blog._id %>" class="btn btn-outline-light mt-auto">Read story <span aria-hidden="true">→</span></a></div>
                </article>
              </div>
            <% }) %>
          </div>
        <% } else { %><div class="empty-state"><div class="eyebrow mb-2"><%= search || selectedCategory ? 'Try another search' : 'The beginning' %></div><h3><%= search || selectedCategory ? 'No matching stories' : 'No stories yet' %></h3><p class="mb-0"><%= search || selectedCategory ? 'Change your search or category to explore more.' : 'Be the first to share an idea with the community.' %></p></div><% } %>
        <% if (pageCount > 1) { %>
          <nav class="story-pagination" aria-label="Story pages">
            <% if (currentPage > 1) { %><a class="btn btn-outline-light" href="/?q=<%= encodeURIComponent(search) %>&category=<%= encodeURIComponent(selectedCategory) %>&page=<%= currentPage - 1 %>">← Newer</a><% } %>
            <span>Page <%= currentPage %> of <%= pageCount %></span>
            <% if (currentPage < pageCount) { %><a class="btn btn-outline-light" href="/?q=<%= encodeURIComponent(search) %>&category=<%= encodeURIComponent(selectedCategory) %>&page=<%= currentPage + 1 %>">Older →</a><% } %>
          </nav>
        <% } %>
      </section>
    </main>
    <%- include('./partials/footer') %>
    <%- include('./partials/scripts') %>
  </body>
</html>
