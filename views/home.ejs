<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>Homepage</title>
    <style>
      .card-img-top {
        width: 100%;
        height: auto;
      }
      body {
        background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
        margin: 0;
      }
    </style>
  </head>
  <body class="d-flex flex-column min-vh-100">
    <%- include('./partials/nav') %>

    <main class="flex-fill">
      <div class="container mt-4">
        <div class="row gy-4">
          <% blogs.forEach(blog => { %>
          <div class="col-12 col-sm-6 col-md-4 col-lg-3 d-flex">
            <div class="card h-100 w-100">
              <img src="<%= blog.coverImageURL %>" class="card-img-top" />
              <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= blog.title %></h5>
                <a href="/blog/<%= blog._id %>" class="btn btn-primary mt-auto">
                  View
                </a>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </main>

    <footer class="py-3 text-center text-white" style="background-color: #1e1e2f">
      <div class="container">
        &copy; <%= new Date().getFullYear() %> BlogVerse by
        <strong>Jiya Nainwani</strong>. All rights reserved.
      </div>
    </footer>

    <%- include('./partials/scripts') %>
  </body>
</html>
