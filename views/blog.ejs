<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>Blog</title>
  </head>
  <body>
    <%- include('./partials/nav') %>
    <div class="container mt-4">
      <h1><%= blog.title %></h1>
      <img src="<%= blog.coverImageURL %>" alt="" width="600px" />
      <pre class="mt-3"><%=blog.body %></pre>
    </div>

    <div class="container mt-4">
      <img src="<%= blog.createdBy.profileImageUrl %>" width="50px" /> <%=
      blog.createdBy.fullName %>
    </div>
    <div class="container mt-2">
      <h2>Comments (<%= comments.length %>)</h2>
      <%if(locals.user){ %>
      <form action="/blog/comment/<%= blog._id %>" method="post">
        <div class="mb-3">
          <input
            type="text"
            name="content"
            class="form-control"
            placeholder="Enter your comment"
          />

          <button type="submit" class="btn btn-sm btn-primary mt-3">Add</button>
        </div>
      </form>
      <% } %>
      <div class="mt-3">
        <% comments.forEach(comment => { %>
        <div>
          <img src="<%= comment.createdBy.profileImageUrl %>" width="50px" />
          <%= comment.createdBy.fullName %>:
          <pre><%= comment.content %></pre>
        </div>
        <% }) %>
      </div>
    </div>
    <footer
      class="mt-5 py-3 text-center text-white"
      style="background-color: #1e1e2f"
    >
      <div class="container">
        &copy; <%= new Date().getFullYear() %> BlogVerse by
        <strong>Jiya Nainwani</strong>. All rights reserved.
      </div>
    </footer>

    <%- include('./partials/scripts') %>
  </body>
</html>
