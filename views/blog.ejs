<!DOCTYPE html>
<html lang="en">
  <head><%- include('./partials/head') %><title><%= blog.title %> — BlogVerse</title></head>
  <body class="d-flex flex-column min-vh-100">
    <%- include('./partials/nav') %>
    <main class="flex-fill blog-wrap">
      <article class="article">
        <img class="article-cover" src="<%= blog.coverImageURL || '/images/default.jpg' %>" alt="Cover for <%= blog.title %>" />
        <div class="article-content">
          <div class="eyebrow">A community story</div>
          <h1><%= blog.title %></h1>
          <div class="article-meta"><span class="category-pill"><%= blog.category || 'Other' %></span><span><%= readingMinutes %> min read</span></div>
          <div class="author"><img src="<%= blog.createdBy.profileImageUrl || '/images/default.jpg' %>" alt="" /><div><a href="/user/<%= blog.createdBy._id %>"><strong><%= blog.createdBy.fullName %></strong></a><span>Story author</span></div></div>
          <div class="story-actions">
            <% if (locals.user) { %>
              <form action="/blog/<%= blog._id %>/like" method="post"><button class="btn <%= isLiked ? 'btn-primary' : 'btn-outline-light' %>" type="submit"><%= isLiked ? '♥ Liked' : '♡ Like' %> <span class="action-count"><%= likeCount %></span></button></form>
              <form action="/blog/<%= blog._id %>/bookmark" method="post"><button class="btn <%= isBookmarked ? 'btn-primary' : 'btn-outline-light' %>" type="submit"><%= isBookmarked ? '★ Saved' : '☆ Save story' %></button></form>
            <% } else { %><span class="text-secondary"><%= likeCount %> likes</span><% } %>
            <% if (locals.user && String(user._id) === String(blog.createdBy._id)) { %>
              <a class="btn btn-outline-light ms-auto" href="/blog/edit/<%= blog._id %>">Edit story</a>
              <form action="/blog/delete/<%= blog._id %>" method="post" onsubmit="return confirm('Delete this story and its comments? This cannot be undone.');"><button class="btn btn-outline-danger" type="submit">Delete</button></form>
            <% } %>
          </div>
          <pre class="article-body"><%= blog.body %></pre>
        </div>
      </article>
      <section class="comments" id="conversation">
        <h2>Conversation <span class="text-secondary">(<%= comments.length %>)</span></h2>
        <% if (locals.user) { %>
          <form action="/blog/comment/<%= blog._id %>" method="post" class="mb-4">
            <label for="content" class="form-label">Add to the conversation</label>
            <textarea id="content" name="content" class="form-control" rows="3" placeholder="Share a thoughtful response…" required></textarea>
            <button type="submit" class="btn btn-primary mt-3">Post comment</button>
          </form>
        <% } else { %><p class="text-secondary mb-4"><a href="/user/signin">Sign in</a> to join the conversation.</p><% } %>
        <% if (comments.length) { %>
          <% comments.forEach(comment => { %>
          <% if (comment.createdBy) { %><div class="comment"><img src="<%= comment.createdBy.profileImageUrl || '/images/default.jpg' %>" alt="" /><div class="comment-main"><strong><%= comment.createdBy.fullName %></strong>
              <% if (locals.user && String(user._id) === String(comment.createdBy._id)) { %>
                <form action="/blog/comment/<%= comment._id %>/edit" method="post" class="comment-edit"><textarea class="form-control" name="content" maxlength="2000" required><%= comment.content %></textarea><button class="btn btn-sm btn-outline-light mt-2" type="submit">Save edit</button></form>
                <form action="/blog/comment/<%= comment._id %>/delete" method="post" onsubmit="return confirm('Delete this comment?');"><button class="comment-delete" type="submit">Delete comment</button></form>
              <% } else { %><p><%= comment.content %></p><% } %>
            </div></div><% } %>
          <% }) %>
        <% } else { %><p class="text-secondary mb-0">No comments yet. Start the conversation.</p><% } %>
      </section>
    </main>
    <%- include('./partials/footer') %>
    <%- include('./partials/scripts') %>
  </body>
</html>
