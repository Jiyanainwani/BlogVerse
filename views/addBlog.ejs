<!DOCTYPE html>
<html lang="en">
  <head><%- include('./partials/head') %><title><%= blog ? 'Edit story' : 'Write a story' %> — BlogVerse</title></head>
  <body class="d-flex flex-column min-vh-100">
    <%- include('./partials/nav') %>
    <main class="flex-fill editor-wrap">
      <form class="editor-card" action="<%= blog ? `/blog/edit/${blog._id}` : '/blog' %>" enctype="multipart/form-data" method="post">
        <div class="eyebrow"><%= blog ? 'Make it yours' : 'Your voice belongs here' %></div>
        <h1><%= blog ? 'Edit your story' : 'Write a story' %></h1>
        <p class="intro"><%= blog ? 'Polish your words and keep your readers in the loop.' : 'Give your idea a title, a little context, and room to breathe.' %></p>
        <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
        <div class="mb-4"><label for="title" class="form-label">Story title</label><input type="text" class="form-control" id="title" name="title" value="<%= blog ? blog.title : '' %>" placeholder="A title that draws readers in" maxlength="160" required /></div>
        <div class="mb-4"><label for="category" class="form-label">Category</label><select class="form-select" id="category" name="category" required><% categories.forEach(category => { %><option value="<%= category %>" <%= (blog ? blog.category : 'Other') === category ? 'selected' : '' %>><%= category %></option><% }) %></select></div>
        <div class="mb-4"><label for="coverImage" class="form-label">Cover image</label><input type="file" class="form-control" id="coverImage" name="coverImage" accept="image/jpeg,image/png,image/webp" /><div class="form-text">JPG, PNG, or WEBP · up to 5 MB</div><img id="coverImagePreview" class="cover-preview <%= blog && blog.coverImageURL ? '' : 'd-none' %>" src="<%= blog && blog.coverImageURL ? blog.coverImageURL : '' %>" alt="Selected cover preview" /></div>
        <div class="mb-4"><label for="body" class="form-label">Your story</label><textarea name="body" class="form-control" id="body" placeholder="Start writing…" required><%= blog ? blog.body : '' %></textarea></div>
        <button type="submit" class="btn btn-primary"><%= blog ? 'Save changes' : 'Publish story' %> <span aria-hidden="true">→</span></button>
      </form>
    </main>
    <%- include('./partials/footer') %>
    <%- include('./partials/scripts') %>
    <script>
      const imageInput = document.getElementById('coverImage');
      const imagePreview = document.getElementById('coverImagePreview');
      imageInput.addEventListener('change', () => {
        const file = imageInput.files && imageInput.files[0];
        if (!file) return;
        imagePreview.src = URL.createObjectURL(file);
        imagePreview.classList.remove('d-none');
      });
    </script>
  </body>
</html>
