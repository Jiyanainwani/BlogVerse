<!DOCTYPE html>
<html lang="en">
  <head><%- include('./partials/head') %><title>Create account — BlogVerse</title></head>
  <body class="d-flex flex-column min-vh-100">
    <%- include('./partials/nav') %>
    <main class="flex-fill auth-wrap">
      <form class="auth-card" action="/user/signup" method="post">
        <div class="eyebrow">Make yourself at home</div><h1>Join the conversation</h1><p class="intro">Create an account and share what’s on your mind.</p>
        <% if (locals.error) { %><div class="alert alert-warning" role="alert"><%= error %> <a href="/user/signin">Sign in</a></div><% } %>
        <div class="mb-3"><label for="fullName" class="form-label">Full name</label><input type="text" class="form-control" id="fullName" name="fullName" value="<%= typeof fullName === 'undefined' ? '' : fullName %>" placeholder="Your name" autocomplete="name" required /></div>
        <div class="mb-3"><label for="email" class="form-label">Email address</label><input type="email" name="email" class="form-control" id="email" value="<%= typeof email === 'undefined' ? '' : email %>" placeholder="you@example.com" autocomplete="email" required /></div>
        <div class="mb-4"><label for="password" class="form-label">Password</label><input type="password" name="password" class="form-control" id="password" autocomplete="new-password" required /></div>
        <button type="submit" class="btn btn-primary w-100">Create account</button>
        <p class="auth-foot mb-0">Already a member? <a href="/user/signin">Sign in</a></p>
      </form>
    </main>
    <%- include('./partials/footer') %><%- include('./partials/scripts') %>
  </body>
</html>
