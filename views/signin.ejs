<!DOCTYPE html>
<html lang="en">
  <head><%- include('./partials/head') %><title>Sign in — BlogVerse</title></head>
  <body class="d-flex flex-column min-vh-100">
    <%- include('./partials/nav') %>
    <main class="flex-fill auth-wrap">
      <form class="auth-card" action="/user/signin" method="post">
        <div class="eyebrow">Good to have you back</div><h1>Welcome back</h1><p class="intro">Sign in to keep reading and sharing.</p>
        <% if (locals.error) { %><div class="alert alert-warning" role="alert"><%= error %></div><% } %>
        <div class="mb-3"><label for="email" class="form-label">Email address</label><input type="email" name="email" class="form-control" id="email" value="<%= typeof email === 'undefined' ? '' : email %>" placeholder="you@example.com" autocomplete="email" required /></div>
        <div class="mb-4"><label for="password" class="form-label">Password</label><input type="password" name="password" class="form-control" id="password" autocomplete="current-password" required /></div>
        <button type="submit" class="btn btn-primary w-100">Sign in</button>
        <p class="auth-foot mb-0">New to BlogVerse? <a href="/user/signup">Create an account</a></p>
      </form>
    </main>
    <%- include('./partials/footer') %><%- include('./partials/scripts') %>
  </body>
</html>
