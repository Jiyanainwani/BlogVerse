<!DOCTYPE html>
<html lang="en">
  <head><%- include('./partials/head') %><title><%= isBookmarks ? 'Saved stories' : `${author.fullName} — BlogVerse` %></title></head>
  <body class="d-flex flex-column min-vh-100">
    <%- include('./partials/nav') %>
    <main class="flex-fill post-grid author-page">
      <header class="author-header">
        <img src="<%= author.profileImageUrl || '/images/default.jpg' %>" alt="" />
        <div><div class="eyebrow"><%= isBookmarks ? 'Your reading list' : 'Writer profile' %></div><h1><%= isBookmarks ? 'Saved stories' : author.fullName %></h1><p><%= blogs.length %> <%= isBookmarks ? 'saved' : 'published' %> stor<%= blogs.length === 1 ? 'y' : 'ies' %></p></div>
      </header>
      <% if (blogs.length) { %>
        <div class="author-story-grid">
          <% blogs.forEach(blog => { %>
            <article class="card post-card">
              <img src="<%= blog.coverImageURL || '/images/default.jpg' %>" class="card-img-top" alt="Cover for <%= blog.title %>" loading="lazy" />
              <div class="card-body d-flex flex-column"><span class="category-pill"><%= blog.category || 'Other' %></span><h2 class="card-title"><%= blog.title %></h2><a href="/blog/<%= blog._id %>" class="btn btn-outline-light mt-auto">Read story <span aria-hidden="true">→</span></a></div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state"><h2><%= isBookmarks ? 'Your reading list is empty' : 'No stories published yet' %></h2><p class="mb-0"><%= isBookmarks ? 'Save a story and it will be waiting here.' : 'Check back soon for new writing.' %></p></div>
      <% } %>
    </main>
    <%- include('./partials/footer') %><%- include('./partials/scripts') %>
  </body>
</html>
